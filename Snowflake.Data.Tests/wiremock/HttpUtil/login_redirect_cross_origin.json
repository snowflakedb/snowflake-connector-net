{
    "mappings": [
        {
            "scenarioName": "Login redirect cross origin",
            "request": {
                "urlPathPattern": "/session/v1/login-request.*",
                "method": "POST"
            },
            "response": {
                "status": 307,
                "headers": {
                    "Location": "https://other.host.com/session/v1/login-request"
                }
            }
        }
    ]
}
